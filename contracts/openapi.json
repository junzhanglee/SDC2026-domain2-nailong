  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Provider-Signature",
        "description": "Placeholder; exact signature headers and verification algorithm depend on confirmed provider contract."
      }
    },
    "schemas": {
      "BusinessEvent": {
        "type": "object",
        "required": [
          "tenant_id",
          "event_id",
          "source",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "description": "Must match authenticated principal or configured webhook tenant; never trust body alone."
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "payments",
              "accounting",
              "payroll",
              "crm",
              "commerce",
              "whatsapp"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Supplier adapter schema to be confirmed; do not pass through unvalidated."
          }
        }
      }
    }
